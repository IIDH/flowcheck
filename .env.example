# Copia este archivo a .env.local y completa con los datos de tu proyecto Supabase
# (Supabase → Project Settings → API)

# Frontend (Vite los expone al navegador)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# API Node (funciones /api en Vercel). Puede ser la misma anon key: la API
# reenvía el JWT del usuario, así que RLS sigue aplicando.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Recordatorios push (genera las claves con: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tudominio.com

# Cron diario de recordatorios (solo servidor / Vercel)
CRON_SECRET=una-cadena-larga-aleatoria
SUPABASE_SERVICE_ROLE_KEY=

# Anti-bots en registro/login (Cloudflare Turnstile). Opcional: si está vacío no se muestra.
# La clave SECRETA de Turnstile va en Supabase → Authentication → Attack Protection, no aquí.
VITE_TURNSTILE_SITE_KEY=

# Login con Google (requiere configurar el proveedor en Supabase). "true" para mostrar el botón.
VITE_ENABLE_GOOGLE=
